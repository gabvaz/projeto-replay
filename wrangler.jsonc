{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "projeto-replay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "account_id": "10a01444ca41e5cf404c639da84eb47e",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replay-db",
      "database_id": "ef8f09c2-b761-40be-a856-42efa8c22bd1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CLIPS",
      "bucket_name": "replay-clips"
    }
  ],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /__scheduled: só existe no `wrangler dev --test-scheduled`
    "run_worker_first": [
      "/api/*",
      "/edge/*",
      "/admin/*",
      "/clips/*",
      "/courts/*",
      "/c/*",
      "/v/*",
      "/portal/*",
      "/a/*",
      "/brand/*",
      "/__scheduled"
    ]
  },
  "vars": {
    "RETENTION_DAYS": "7",
    // Sem heartbeat há mais que isso = offline (agent manda a cada 60s)
    "DEVICE_OFFLINE_SEC": "180",
    // WhatsApp de suporte mostrado no portal da arena (só dígitos, com DDI). Vazio = esconde.
    "SUPPORT_WHATSAPP": "",
    // Links nos e-mails de alerta
    "APP_URL": "https://projeto-replay.gabrieltenoriovaz-10a.workers.dev",
    // Remetente precisa ser do domínio com Email Routing; destino, endereço verificado nele.
    // Vazio = alerta/resumo só no log (wrangler tail).
    "ALERT_EMAIL_FROM": "",
    "ALERT_EMAIL_TO": ""
  },
  // Descomentar quando o domínio estiver no Email Routing (envio p/ destino verificado é grátis).
  // "send_email": [{ "name": "EMAIL" }],
  "triggers": {
    // Strings iguais a CRON_ALERTS / CRON_DAILY em src/jobs.ts.
    // */5: alertas de equipamento · 09:00 UTC (06:00 BRT): retenção, faturas e resumo do dia
    "crons": ["*/5 * * * *", "0 9 * * *"]
  }
}
