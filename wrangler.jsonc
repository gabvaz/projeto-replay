{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "projeto-replay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "account_id": "10a01444ca41e5cf404c639da84eb47e",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replay-db",
      "database_id": "ef8f09c2-b761-40be-a856-42efa8c22bd1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CLIPS",
      "bucket_name": "replay-clips"
    }
  ],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /__scheduled: só existe no `wrangler dev --test-scheduled`
    "run_worker_first": [
      "/api/*",
      "/edge/*",
      "/admin/*",
      "/clips/*",
      "/courts/*",
      "/c/*",
      "/v/*",
      "/__scheduled"
    ]
  },
  "vars": {
    "RETENTION_DAYS": "7"
  },
  "triggers": {
    // 06:17 UTC = 03:17 BRT
    "crons": ["17 6 * * *"]
  }
}
