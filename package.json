{
  "name": "projeto-replay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "deploy": "npm run build:web && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web",
    "db:migrate:local": "wrangler d1 migrations apply replay-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply replay-db --remote",
    "edge": "node edge/agent.mjs",
    "edge:ui": "node edge/open-ui.mjs",
    "edge:loadtest-6cam": "node edge/loadtest-6cam.mjs",
    "edge:loadtest-6cam:encode": "node edge/loadtest-6cam.mjs --mode=encode",
    "edge:loadtest-pi3": "powershell -ExecutionPolicy Bypass -File edge/run-loadtest-pi3.ps1",
    "admin:device": "node scripts/create-device.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabvaz/projeto-replay.git"
  },
  "license": "ISC",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "hono": "^4.13.9",
    "lucide-react": "^1.56.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.138.0"
  }
}
