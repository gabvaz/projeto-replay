# Edge agent (PC: edge/.env · Pi: /etc/replay/edge.env)
API_BASE=https://projeto-replay.gabrieltenoriovaz-10a.workers.dev
COURT_KEY=demo01
# Token do dispositivo (npm run admin:device). Sem ele o agent não sobe.
EDGE_TOKEN=
HEARTBEAT_SEC=60
# Câmera instalada deitada (vertical sem re-encode): graus no sentido horário, 0|90|270
CAMERA_ROTATION=0
EDGE_PORT=8788
# ~20s do PASSADO no botão = buffer circular contínuo (obrigatório)
PRE_ROLL_SEC=20
POST_ROLL_SEC=3
SEGMENT_SEC=2
# Ignora novos apertos por N s depois de cada clip
COOLDOWN_SEC=5
# Sem RTSP_URL → usa testsrc sintético
# RTSP_URL=rtsp://admin:SENHA_ENCODED@IP:554/onvif1
# tcp (padrão, sem artefato) | udp (câmeras que não aceitam tcp)
RTSP_TRANSPORT=tcp
#
# Botão ESP32 via USB (só Linux; symlink criado pela regra udev do edge/pi/install.sh)
# BUTTON_SERIAL=/dev/replay-button
#
# Buffer: padrão /dev/shm/replay no Linux (RAM), edge/.buffer no PC
# BUFFER_DIR=
# Fila de clips sem internet (sobrevive a reboot): padrão edge/.outbox
# OUTBOX_DIR=/var/lib/replay/outbox
OUTBOX_MAX_MB=200
#
# Instalação (arena): IP da câmera TEM que ser fixo.
# 1) Preferência: reserva DHCP no roteador (MAC → IP) — não no CPE da operadora se for travado
# 2) Ou IP estático na própria câmera (mesmo gateway/máscara da LAN)
# 3) Anotar MAC + IP no checklist; testar após reinício do roteador
# Opcional se o terminal não achar o ffmpeg no PATH:
# FFMPEG_PATH=C:\Users\...\ffmpeg.exe
